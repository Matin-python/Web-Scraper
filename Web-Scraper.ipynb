   "metadata": {},
   "outputs": [],
   "source": [
    "import requests\n",
    "import pandas as pd\n",
    "import time\n",
    "import logging\n",
    "\n",
    "from bs4 import BeautifulSoup\n",
    "from urllib.parse import urljoin\n",
    "from requests.exceptions import RequestException"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 79,
   "id": "41412fd4",
   "metadata": {},
   "outputs": [
    {
     "name": "stderr",
     "output_type": "stream",
     "text": [
      "2026-11-21 22:17:28,257 - INFO - Web Scraper started.\n"
     ]
    }
   ],
   "source": [
    "logging.basicConfig(\n",
    "    level=logging.INFO,\n",
    "    format='%(asctime)s - %(levelname)s - %(message)s',\n",
    "    handlers=[\n",
    "        logging.FileHandler(\"scraper.log\", encoding=\"utf-8\"),\n",
    "        logging.StreamHandler()\n",
    "    ],\n",
    "    force=True\n",
    ")\n",
    "\n",
    "logging.info(\"Web Scraper started.\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 80,
   "id": "36dc45e9",
   "metadata": {},
   "outputs": [],
   "source": [
    "URL = input(\"Enter website URL: \").strip()\n",
    "\n",
    "card_selector = input(\n",
    "    \"Enter the CSS selector for each item/card: \"\n",
    ").strip()\n",
    "\n",
    "title_selector = input(\n",
    "    \"Enter title selector (or leave empty): \"\n",
    ").strip()\n",
    "\n",
    "price_selector = input(\n",
    "    \"Enter price selector (or leave empty): \"\n",
    ").strip()\n",
    "\n",
    "description_selector = input(\n",
    "    \"Enter description selector (or leave empty): \"\n",
    ").strip()\n",
    "\n",
    "link_selector = input(\n",
    "    \"Enter link selector (or leave empty): \"\n",
    ").strip()\n",
    "\n",
    "image_selector = input(\n",
    "    \"Enter image selector (or leave empty): \"\n",
    ").strip()\n",
    "\n",
    "next_page_selector = input(\n",
    "    \"Enter next-page link selector (or leave empty): \"\n",
    ").strip()\n",
    "\n",
    "max_pages = int(input(\"Maximum number of pages to scrape: \"))"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 81,
   "id": "09b35b9a",
   "metadata": {},
   "outputs": [
    {
     "name": "stderr",
     "output_type": "stream",
     "text": [
      "2026-11-21 22:18:09,674 - INFO - Configuration completed.\n"
     ]
    }
   ],
   "source": [
    "session = requests.Session()\n",
    "\n",
    "session.headers.update({\n",
    "    \"User-Agent\": (\n",
    "        \"Mozilla/5.0 (Windows NT 10.0; Win64; x64) \"\n",
    "        \"AppleWebKit/537.36 (KHTML, like Gecko) \"\n",
    "        \"Chrome/120.0.0.0 Safari/537.36\"\n",
    "    )\n",
    "})\n",
    "\n",
    "scraped_data = []\n",
    "visited_urls = set()\n",
    "\n",
    "current_url = URL\n",
    "\n",
    "logging.info(\"Configuration completed.\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 82,
   "id": "9f27a35c",
   "metadata": {},
   "outputs": [
    {
     "name": "stderr",
     "output_type": "stream",
     "text": [
      "2026-11-21 22:18:09,698 - INFO - Scraping page 1: https://webscraper.io/test-sites/e-commerce/static/computers/laptops\n",
      "2026-11-21 22:18:10,929 - INFO - Found 6 items.\n",
      "2026-11-21 22:18:12,936 - INFO - Scraping page 2: https://webscraper.io/test-sites/e-commerce/static/computers/laptops?page=2\n",
      "2026-11-21 22:18:15,145 - INFO - Found 6 items.\n",
      "2026-11-21 22:18:17,157 - INFO - Scraping page 3: https://webscraper.io/test-sites/e-commerce/static/computers/laptops?page=3\n",
      "2026-11-21 22:18:17,648 - INFO - Found 6 items.\n",
      "2026-11-21 22:18:19,652 - INFO - Scraping process finished.\n"
     ]
    }
   ],
   "source": [
    "for page_number in range(1, max_pages + 1):\n",
    "\n",
    "    if current_url in visited_urls:\n",
    "        logging.warning(\"Page already visited. Stopping pagination.\")\n",
    "        break\n",
    "\n",
    "    visited_urls.add(current_url)\n",
    "\n",
    "    logging.info(f\"Scraping page {page_number}: {current_url}\")\n",
    "\n",
    "    try:\n",
    "        response = session.get(current_url, timeout=20)\n",
    "        response.raise_for_status()\n",
    "\n",
    "    except RequestException as error:\n",
    "        logging.error(f\"Request failed: {error}\")\n",
    "        break\n",
    "\n",
    "    soup = BeautifulSoup(response.content, \"html.parser\")\n",
    "\n",
    "    cards = soup.select(card_selector)\n",
    "\n",
    "    logging.info(f\"Found {len(cards)} items.\")\n",
    "\n",
    "    if not cards:\n",
    "        logging.warning(\"No items found. Check your CSS selector.\")\n",
    "        break\n",
    "\n",
    "    for card in cards:\n",
    "\n",
    "        item = {\n",
    "            \"Title\": None,\n",
    "            \"Price\": None,\n",
    "            \"Description\": None,\n",
    "            \"Link\": None,\n",
    "            \"Image\": None,\n",
    "            \"Source Page\": current_url\n",
    "        }\n",
    "\n",
    "        # Extract title\n",
    "        if title_selector:\n",
    "            element = card.select_one(title_selector)\n",
    "\n",
    "            if element:\n",
    "                item[\"Title\"] = element.get_text(\" \", strip=True)\n",
    "\n",
    "        # Extract price\n",
    "        if price_selector:\n",
    "            element = card.select_one(price_selector)\n",
    "\n",
    "            if element:\n",
    "                item[\"Price\"] = element.get_text(\" \", strip=True)\n",
    "\n",
    "        # Extract description\n",
    "        if description_selector:\n",
    "            element = card.select_one(description_selector)\n",
    "\n",
    "            if element:\n",
    "                item[\"Description\"] = element.get_text(\" \", strip=True)\n",
    "\n",
    "        # Extract link\n",
    "        if link_selector:\n",
    "            element = card.select_one(link_selector)\n",
    "        else:\n",
    "            element = card.select_one(\"a[href]\")\n",
    "\n",
    "        if element and element.get(\"href\"):\n",
    "            item[\"Link\"] = urljoin(current_url, element[\"href\"])\n",
    "\n",
    "        # Extract image\n",
    "        if image_selector:\n",
    "            element = card.select_one(image_selector)\n",
    "        else:\n",
    "            element = card.select_one(\"img\")\n",
    "\n",
    "        if element:\n",
    "            image_url = (\n",
    "                element.get(\"src\")\n",
    "                or element.get(\"data-src\")\n",
    "                or element.get(\"data-lazy-src\")\n",
    "            )\n",
    "\n",
    "            if image_url:\n",
    "                item[\"Image\"] = urljoin(current_url, image_url)\n",
    "\n",
    "        scraped_data.append(item)\n",
    "\n",
    "    # Find the next page\n",
    "    if not next_page_selector:\n",
    "        logging.info(\"Pagination is disabled.\")\n",
    "        break\n",
    "\n",
    "    next_page = soup.select_one(next_page_selector)\n",
    "\n",
    "    if not next_page or not next_page.get(\"href\"):\n",
    "        logging.info(\"No next page found.\")\n",
    "        break\n",
    "\n",
    "    next_url = urljoin(current_url, next_page[\"href\"])\n",
    "\n",
    "    if next_url in visited_urls:\n",
    "        logging.warning(\"Next page has already been visited.\")\n",
    "        break\n",
    "\n",
    "    current_url = next_url\n",
    "\n",
    "    # Wait before sending another request\n",
    "    time.sleep(2)\n",
    "\n",
    "logging.info(\"Scraping process finished.\")"
   ]
  },

 ],
